{
  "name": "coy-discover-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Coy Discover - Privacy-Focused Dating & Discovery Experience",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "client:build": "npm --prefix client build",
    "seed": "npm --prefix server run seed",
    "test:backend": "npm --prefix server test",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "coy",
    "dating",
    "discover",
    "privacy",
    "react",
    "express",
    "mongodb"
  ],
